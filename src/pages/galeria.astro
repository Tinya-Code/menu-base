---
/**
 * Gallery page (`src/pages/galeria.astro`, route `/galeria`).
 *
 * Sourced server-side from `src/data/api/gallery.json` (with menu fallback).
 * Supports images, direct videos, and embeds (YouTube, TikTok, Facebook).
 * Plain layout with tokens, precio-free.
 */
import Layout from '../storefront/layout/Layout.astro';
import SiteHeader from '../storefront/layout/site-header.astro';
import Footer from '../storefront/layout/footer.astro';
import { loadStorefront, getGalleryCategories } from '../storefront/services/index.js';
import type { GalleryCategory, GalleryItem } from '../storefront/types/menu';

const {
  blocks,
  restaurant,
  settings,
  businessHours,
  decorations,
} = await loadStorefront();

const galleryCategories: GalleryCategory[] = await getGalleryCategories(blocks);
const footerBg = decorations?.footer_bg ?? settings?.footer_bg ?? null;

/** Converts common video platform URLs (YouTube, TikTok, Facebook) to embed URLs. */
function resolveEmbedUrl(item: GalleryItem): string | null {
  const url = item.url ?? '';
  if (!url) return null;

  // YouTube watch / shorts / share URLs
  const ytMatch = url.match(/(?:youtube\.com\/(?:watch\?v=|shorts\/|embed\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
  if (ytMatch) {
    return `https://www.youtube-nocookie.com/embed/${ytMatch[1]}`;
  }

  // TikTok embed URL
  const ttMatch = url.match(/tiktok\.com\/(?:@[^/]+\/video\/|v\/)(\d+)/);
  if (ttMatch) {
    return `https://www.tiktok.com/embed/v2/${ttMatch[1]}`;
  }

  // Facebook video URL
  if (url.includes('facebook.com') && !url.includes('facebook.com/plugins/video.php')) {
    return `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(url)}&show_text=0`;
  }

  // If already an embed URL or other iframe URL
  return url;
}
---

<Layout title="Galería" seo={settings?.seo}>
  <div class="min-h-screen flex flex-col bg-secondary text-primary-text font-body selection:bg-primary selection:text-white">
    <SiteHeader restaurant={restaurant} settings={settings} />

    <main class="flex-1 px-6 py-12 sm:py-20 max-w-7xl mx-auto w-full">
      <!-- Page Header -->
      <header class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <h1 class="text-5xl sm:text-7xl font-display text-white leading-none tracking-tight">
          Nuestra Galería<span class="text-primary">.</span>
        </h1>
        <p class="text-base sm:text-xl text-primary-text/75 font-normal">
          Conocé el arte, la frescura y la experiencia detrás de cada una de nuestras preparaciones nikkei.
        </p>
      </header>

      <!-- Categories with Media -->
      <div class="space-y-16">
        {galleryCategories.map((category) => (
          <section class="space-y-8" data-gallery-category={category.name}>
            <div class="border-b border-white/10 pb-4 flex items-baseline justify-between">
              <h2 class="text-3xl sm:text-4xl font-display text-white tracking-tight flex items-center gap-3">
                <span>{category.name}</span>
                <span class="text-xs font-sans font-bold uppercase tracking-wider text-primary bg-primary/10 px-3 py-1 rounded-full border border-primary/20">
                  {category.items.length} {category.items.length === 1 ? 'ítem' : 'ítems'}
                </span>
              </h2>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
              {category.items.map((item) => {
                const embedUrl = resolveEmbedUrl(item);
                const isVideo = item.type === 'video' || (!item.type && Boolean(item.url?.endsWith('.mp4') || item.url?.endsWith('.webm')));
                const isEmbed = item.type === 'embed' || Boolean(item.embed_html) || (!item.type && Boolean(item.url?.includes('youtube') || item.url?.includes('youtu.be') || item.url?.includes('tiktok') || item.url?.includes('facebook')));
                const isAspect916 = item.aspect_ratio === '9/16' || Boolean(item.url?.includes('shorts') || item.url?.includes('tiktok'));

                return (
                  <article
                    class={`group bg-surface/5 border border-white/10 hover:border-primary/50 rounded-3xl p-5 flex flex-col items-center text-center transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_20px_40px_rgba(220,38,38,0.15)] ${
                      isAspect916 ? 'sm:col-span-1 md:row-span-2' : ''
                    }`}
                    data-gallery-item={item.id}
                  >
                    <!-- Media Container -->
                    <div class={`relative w-full rounded-2xl bg-secondary/80 overflow-hidden mb-4 ${
                      isAspect916 ? 'aspect-[9/16]' : (isVideo || isEmbed ? 'aspect-video' : 'aspect-square flex items-center justify-center p-4')
                    }`}>
                      {item.embed_html ? (
                        <div class="w-full h-full flex items-center justify-center [&_iframe]:w-full [&_iframe]:h-full [&_iframe]:border-0" set:html={item.embed_html} />
                      ) : isEmbed && embedUrl ? (
                        <iframe
                          src={embedUrl}
                          title={item.title}
                          class="w-full h-full border-0"
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                          allowfullscreen
                          loading="lazy"
                        />
                      ) : isVideo && item.url ? (
                        <video
                          src={item.url}
                          poster={item.poster}
                          controls
                          playsinline
                          preload="metadata"
                          class="w-full h-full object-cover"
                        />
                      ) : item.url ? (
                        <img
                          src={item.url}
                          alt={item.alt || item.title}
                          loading="lazy"
                          class="w-full h-full object-contain transform group-hover:scale-110 group-hover:-rotate-2 transition-transform duration-500 ease-out drop-shadow-xl"
                        />
                      ) : null}
                    </div>

                    <h3 class="text-xl sm:text-2xl font-display text-white leading-snug group-hover:text-primary transition-colors">
                      {item.title}
                    </h3>

                    {item.description && (
                      <p class="text-xs sm:text-sm text-primary-text/60 mt-2 line-clamp-2 leading-relaxed">
                        {item.description}
                      </p>
                    )}
                  </article>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    </main>

    <Footer
      restaurant={restaurant}
      settings={settings}
      businessHours={businessHours}
      footerBg={footerBg}
      class="mt-20 block"
    />
  </div>
</Layout>
