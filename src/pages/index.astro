---
/**
 * Menu page — the Astro port of Angular `src/app/page/menu`.
 *
 * Render order follows COMPONENT-ORDER.md §1.2:
 *   category-nav → base-template → cart-trigger → whatsapp-button →
 *   sidebar-cart → product-detail (mounted hidden) → restaurant-closed-modal
 *
 * Data (F5): this page is the single orchestrator. It loads every payload
 * (menu, price ranges, restaurant settings + hours) in frontmatter and passes
 * the resolved values to components as props — nothing under `src/components`
 * fetches, neither at build time nor in the browser. The few values the client
 * scripts still need (hours, settings, price ranges) ship as hidden JSON
 * attributes rendered below and read back by the script.
 *
 * There is no `forkJoin`, no `isLoading` signal and no 800 ms `hidden`
 * artefact: the page ships ready.
 *
 * The product dialog is static, so it is rendered once — hidden — and refilled
 * from the clicked card's `data-product` payload by the script below.
 *
 * The script is also the single owner of the component event contract
 * (`src/utils/events.ts`): delegated card clicks, `add-to-cart` → cart, and
 * the dialog open/close listeners.
 */
import Layout from '../layouts/Layout.astro';
import CategoryNav from '../components/ui/category-nav.astro';
import BaseTemplate from '../components/base-template/base-template.astro';
import CartTrigger from '../components/cart/cart-trigger.astro';
import WhatsAppButton from '../components/ui/whatsapp-button.astro';
import SidebarCart from '../components/cart/sidebar-cart.astro';
import ProductDetail from '../components/base-template/product-detail.astro';
import RestaurantClosedModal from '../components/ui/restaurant-closed-modal.astro';

import { menuService } from '../services/menu.service.js';
import { restaurantService } from '../services/restaurant.service.js';
import type {
  BusinessHours,
  Combo,
  Decorations,
  MenuBlock,
  MenuCategory,
  MenuProduct,
  OrderConfig,
  PriceRange,
  Promotion,
  RestaurantInfo,
  RestaurantProfile,
  RestaurantSettings,
  WhatsappConfig,
} from '../types/menu';

/** What the menu payload must resolve to before it reaches the components. */
interface MenuPayload {
  blocks: MenuBlock[];
  combos: Combo[];
  promotions: Promotion[];
  decorations: Partial<Decorations>;
}

/** Same data Angular's `forkJoin` resolved, minus the artificial delay. */
const menuPayload: MenuPayload = await menuService.load().catch((error) => {
  console.error('[menu] could not load the menu payload.', error);
  return { blocks: [], combos: [], promotions: [], decorations: {} };
});
const { blocks, combos, promotions, decorations } = menuPayload;

/** Price ranges and the restaurant payload — also loaded only here (F5). */
await Promise.all([
  menuService.getPriceRanges().catch(() => {}),
  restaurantService.load().catch(() => {}),
]);

const priceRanges: PriceRange[] = menuService.priceRanges;
const restaurantInfo: RestaurantInfo | null = restaurantService.info;
const restaurant: RestaurantProfile | null = restaurantService.restaurant;
const settings: RestaurantSettings | null = restaurantService.settings;
const orderConfig: OrderConfig | null = restaurantService.orderConfig;
const whatsappConfig: WhatsappConfig | null = restaurantService.whatsappConfig;

/** Raw schedule; `undefined` when the settings payload never arrived. */
const rawHours: BusinessHours | undefined = restaurantService.businessConfig?.business_hours;
const businessHours: BusinessHours = rawHours ?? {};

/** Ordering rules every card and dialog renders from. */
const canOrder = orderConfig?.delivery_enabled ?? true;
const maxOrderQuantity = orderConfig?.max_order_quantity ?? 99;
const whatsappPhone = whatsappConfig?.number ?? '';

/** `allCategories` from `Menu.ngOnInit` — `{ category }` wrappers. */
const allCategories: Array<{ category: MenuCategory }> = blocks.flatMap((block) =>
  (block.categories ?? []).map((category) => ({ category })),
);

/** Every product, used to pick the dialog's template product. */
const allProducts: MenuProduct[] = blocks.flatMap((block) =>
  (block.categories ?? []).flatMap((category) => category.products ?? []),
);

/**
 * The dialog renders one product at build time; prefer one with a price range
 * so the options list markup exists client-side, then refill it on click.
 */
const placeholderProduct: MenuProduct =
  allProducts.find((product) => product?.price_range_id) ??
  allProducts[0] ??
  ({} as MenuProduct);

/** Serialized payloads the client scripts read back — all rendered below. */
const priceRangesJson = JSON.stringify(priceRanges).replace(/</g, '\\u003c');
const restaurantInfoJson = JSON.stringify(restaurantInfo).replace(/</g, '\\u003c');

/**
 * The hours attribute is omitted entirely when the schedule never arrived:
 * `readBusinessHours()` then returns `null`, which `isOpenAt()` treats as
 * "open" — the same semantics the old failed client-side fetch had.
 */
const hoursJson =
  rawHours === undefined ? null : JSON.stringify(rawHours).replace(/</g, '\\u003c');
---

<Layout title="Carta">
  <div data-menu-page>
    <CategoryNav categories={allCategories} />

    <BaseTemplate
      blocks={blocks}
      combos={combos}
      promotions={promotions}
      decorations={decorations}
      restaurant={restaurant}
      settings={settings}
      businessHours={businessHours}
      canOrder={canOrder}
      priceRanges={priceRanges}
    />

    <CartTrigger />

    <WhatsAppButton phone={whatsappPhone} message={whatsappConfig?.message_template ?? null} />

    <SidebarCart orderConfig={orderConfig} whatsappConfig={whatsappConfig} />

    <!-- Product detail: mounted hidden, revealed (and refilled) on click. -->
    <div data-product-detail-host hidden>
      <ProductDetail
        product={placeholderProduct}
        priceRanges={priceRanges}
        maxQuantity={maxOrderQuantity}
        canOrder={canOrder}
        whatsappPhone={whatsappPhone}
      />
    </div>

    <RestaurantClosedModal businessHours={businessHours} />
  </div>

  <div id="price-ranges-data" data-price-ranges={priceRangesJson} hidden></div>
  <div id="restaurant-info-data" data-restaurant-info={restaurantInfoJson} hidden></div>
  {
    hoursJson !== null && (
      <div id="business-hours-data" data-business-hours={hoursJson} hidden></div>
    )
  }

  <script>
    import { emit, on } from '../utils/events';
    import { readJson, readProduct } from '../utils/dom';
    import { precio } from '../utils/format.js';
    import { cartService } from '../services/cart.service.js';
    import { restaurantService } from '../services/restaurant.service.js';
    import { findPriceRange } from '../services/menu.service.js';
    import type {
      MenuProduct,
      OrderableProduct,
      PriceRange,
      PriceRangeEntry,
      RestaurantInfo,
    } from '../types/menu';

    // The settings payload ships with the page: replay it into the shared
    // service so the cart totals read the values the build used. Every cart is
    // still empty while the modules evaluate, so nothing visible renders
    // before this line (F5).
    restaurantService.hydrate(
      readJson<RestaurantInfo | null>(
        document.getElementById('restaurant-info-data'),
        'data-restaurant-info',
        null,
      ),
    );

    const ENTRY_BASE_CLASSES =
      'flex items-center justify-between p-2.5 rounded-xl md:rounded-2xl border-2 border-secondary/5 hover:border-accent/30 transition-all text-left group';
    const ENTRY_SELECTED_CLASSES = ['border-accent', 'bg-accent/5'];
    const FALLBACK_DESCRIPTION =
      'Un clásico preparado con los secretos mejor guardados de nuestra cocina.';

    const host = document.querySelector<HTMLElement>('[data-product-detail-host]');
    const root = document.querySelector<HTMLElement>('[data-product-detail]');

    const priceRanges: PriceRange[] = (() => {
      const parsed = readJson<PriceRange[] | null>(
        document.getElementById('price-ranges-data'),
        'data-price-ranges',
        null,
      );
      return Array.isArray(parsed) ? parsed : [];
    })();

    const escapeHtml = (value: unknown) =>
      String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');

    /** Rebuild the price options for the product that is about to open. */
    const renderEntries = (root: HTMLElement, range: PriceRange | null) => {
      const list = root.querySelector<HTMLElement>('[data-entry-list]');
      const grid = root.querySelector<HTMLElement>('[data-entry-grid]');
      if (!list || !grid) return null;

      const candidate = range?.entries;
      const entries: PriceRangeEntry[] = Array.isArray(candidate) ? candidate : [];

      list.hidden = entries.length === 0;
      list.setAttribute('data-selected-index', entries.length > 0 ? '0' : '');
      grid.innerHTML = entries
        .map(
          (entry, index) => `
            <button
              data-entry-index="${index}"
              data-entry='${JSON.stringify(entry).replace(/'/g, '&#39;')}'
              type="button"
              class="${ENTRY_BASE_CLASSES}${index === 0 ? ' border-accent bg-accent/5' : ''}"
            >
              <div class="flex flex-col">
                <span class="font-display text-sm md:text-lg text-secondary group-hover:text-accent transition-colors">
                  ${escapeHtml(entry.qty)} Unidades
                </span>
                ${
                  entry.bonus
                    ? `<span class="text-[9px] md:text-[10px] font-bold text-accent-muted">${escapeHtml(entry.bonus)}</span>`
                    : ''
                }
              </div>
              <span class="font-display text-base md:text-xl text-secondary">${precio(Number(entry.price))}</span>
            </button>`,
        )
        .join('');

      return entries.length > 0 ? entries[0] : null;
    };

    /** Paint the dialog with the product the user clicked. */
    const fill = (product: MenuProduct) => {
      if (!root) return;

      root.setAttribute('data-product', JSON.stringify(product));

      const name = root.querySelector<HTMLElement>('[data-detail-name]');
      if (name) name.textContent = product?.name ?? '';

      const description = root.querySelector<HTMLElement>('[data-detail-description]');
      if (description) description.textContent = product?.description || FALLBACK_DESCRIPTION;

      const imageSection = root.querySelector<HTMLElement>('[data-detail-image-section]');
      const image = root.querySelector<HTMLImageElement>('[data-detail-image]');
      const dialog = root.querySelector<HTMLElement>('[data-detail-dialog]');
      const hasImage = Boolean(product?.image_url);

      if (imageSection) imageSection.hidden = !hasImage;
      if (image) {
        image.src = product?.image_url ?? '';
        image.alt = product?.name ?? '';
      }
      if (dialog) {
        dialog.classList.toggle('md:grid-cols-2', hasImage);
        dialog.classList.toggle('md:grid-cols-1', !hasImage);
      }

      const range = findPriceRange(priceRanges, product?.price_range_id);
      const firstEntry = renderEntries(root, range);

      const price = root.querySelector<HTMLElement>('[data-current-price]');
      if (price) {
        const value = firstEntry
          ? Number(firstEntry.price)
          : product?.price === null || product?.price === undefined || product?.price === ''
            ? 0
            : Number(product.price);
        price.textContent = Number.isNaN(value) ? '' : precio(value);
      }

      const label = root.querySelector<HTMLElement>('[data-entry-label]');
      if (label) {
        label.hidden = !firstEntry;
        label.textContent = firstEntry ? `${firstEntry.qty} Unids.` : '';
      }

      // Reset the stepper to 1 (the Angular dialog mounts fresh each time).
      const stepper = root.querySelector<HTMLElement>('[data-quantity]');
      if (stepper) {
        stepper.setAttribute('data-qty-value', '1');
        const qtyLabel = stepper.querySelector<HTMLElement>('[data-qty-label]');
        if (qtyLabel) qtyLabel.textContent = '1';
        const dec = stepper.querySelector<HTMLButtonElement>('[data-qty-dec]');
        const inc = stepper.querySelector<HTMLButtonElement>('[data-qty-inc]');
        if (dec) dec.disabled = true;
        if (inc) inc.disabled = false;
      }
    };

    // ─── Event contract (see `src/utils/events.ts`) ─────────────────────────
    // The page is the single owner of every cross-component collaboration:
    // cards are pure markup, the add button only announces its press, and the
    // product dialog only announces its actions.

    on('product-click', (detail) => {
      const product = detail?.product;
      if (!host || !product) return;

      fill(product);
      host.hidden = false;
      document.documentElement.style.overflow = 'hidden';
    });

    on('close-product-detail', () => {
      if (!host) return;
      host.hidden = true;
      document.documentElement.style.overflow = '';
    });

    /**
     * The one owner of `add-to-cart`: dispatchers never touch the cart
     * themselves (they used to run `addItem` as the event's "default action"
     * after `emit(...) === false` — a vetoed dispatch still skips the add).
     */
    on('add-to-cart', (detail, event) => {
      if (event.defaultPrevented) return;
      cartService.addItem(detail.product, detail.quantity, detail.selectedEntry);
    });

    // Card body click → `product-click` (delegation replaces the per-card
    // scripts; combo cards never opened the dialog, so they stay inert).
    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const card = target?.closest('[data-template-card], [data-promotion-card]');
      if (!card) return;
      // The add button owns this click (it announces `add-button-click`).
      if (target?.closest('[data-add-button]')) return;
      // "Ver más" toggles the clamp in place, it never opens the dialog.
      if (target?.closest('[data-toggle-description]')) return;

      const product = readProduct(card);
      if (product) emit('product-click', { product });
    });

    // "＋" click → straight to the cart, or the dialog when the product needs
    // a price-range selection (the old per-card `add-button-click` handlers).
    on('add-button-click', (_detail, event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;

      const templateCard = target.closest('[data-template-card]');
      if (templateCard) {
        const product = readProduct(templateCard);
        if (!product) return;

        if (templateCard.getAttribute('data-has-range') === 'true') {
          emit('product-click', { product });
          return;
        }

        emit('add-to-cart', { product, quantity: 1, selectedEntry: undefined });
        return;
      }

      const comboCard = target.closest('[data-combo-card]');
      if (comboCard) {
        const combo = readJson<OrderableProduct | null>(comboCard, 'data-combo', null);
        if (combo) emit('add-to-cart', { product: combo, quantity: 1, selectedEntry: undefined });
        return;
      }

      const promotionCard = target.closest('[data-promotion-card]');
      if (promotionCard) {
        const promotion = readJson<OrderableProduct | null>(promotionCard, 'data-promotion', null);
        if (promotion)
          emit('add-to-cart', { product: promotion, quantity: 1, selectedEntry: undefined });
      }
    });
  </script>
</Layout>
