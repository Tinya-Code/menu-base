---
/**
 * BlockPromotions — slider of promotion cards with its own section title.
 *
 * Props:
 * - `promotions`  — promotions rendered inside the slider (required, defaults to `[]`)
 * - `canOrder`    — forwarded to each card (page-loaded ordering flag)
 * - `title`       — section heading (default `'Promociones'`)
 * - `description` — section sub-text (default `'Aprovecha nuestras ofertas especiales'`)
 *
 * Promotion cards expose `data-promotion` / `data-product` payloads; the page
 * dispatches the bubbling `add-to-cart` and `product-click` CustomEvents for
 * them (see `src/pages/index.astro`).
 */
import PromotionCard from '../cards/promotion-card.astro';
import TemplateSectionTitle from '../template-section-title.astro';
import Slider from '../../ui/slider.astro';
import type { Promotion } from '../../types/menu';

interface Props {
  promotions?: Promotion[];
  canOrder?: boolean;
  title?: string;
  description?: string;
  cardComponent?: any;
}

const {
  promotions = [],
  canOrder = true,
  title = 'Promociones',
  description = 'Aprovecha nuestras ofertas especiales',
  cardComponent: Card = PromotionCard,
} = Astro.props;

const hasCustomSlot = Astro.slots.has('default');
---

{
  (promotions.length > 0 || hasCustomSlot) && (
    <section class="relative py-12 px-8">
      <TemplateSectionTitle title={title} description={description} />

      <Slider showArrows={true}>
        {hasCustomSlot ? (
          <slot />
        ) : (
          promotions.map((promotion) => (
            <Card promotion={promotion} canOrder={canOrder} />
          ))
        )}
      </Slider>
    </section>
  )
}
