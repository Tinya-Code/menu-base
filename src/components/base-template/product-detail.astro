---
/**
 * ProductDetail — modal with image, price-range options, quantity stepper and
 * the two order actions (cart / WhatsApp).
 *
 * Props:
 * - `product`       — product payload (required)
 *
 * Announces its actions as bubbling CustomEvents: `add-to-cart` (the page is
 * the single owner of the cart mutation) and `close-product-detail`; the
 * dialog always closes after adding, like the Angular version.
 *
 * Client state (quantity, selected price entry) is handled locally in the
 * `<script>` below — it never touches the cart until the user adds the item.
 */
import MessageCircle from '../icons/message-circle.astro';
import Minus from '../icons/minus.astro';
import Plus from '../icons/plus.astro';
import ShoppingBag from '../icons/shopping-bag.astro';
import X from '../icons/x.astro';
import { precio } from '../../utils/format.js';
import { menuService } from '../../services/menu.service.js';
import { restaurantService } from '../../services/restaurant.service.js';

interface Props {
  product: any;
}

const { product } = Astro.props;

await restaurantService.load();
await menuService.getPriceRanges();

const maxQuantity = restaurantService.orderConfig?.max_order_quantity ?? 99;
const canOrder = restaurantService.orderConfig?.delivery_enabled ?? true;
const whatsappPhone = restaurantService.whatsappConfig?.number ?? '';

const priceRange = menuService.findPriceRange(product?.price_range_id);

/** The product expects a range but the data never arrived. */
const isLoadingRange = !!product?.price_range_id && !priceRange;

/** Defaults to the first entry, exactly like the Angular `selectedEntry`. */
const selectedEntry =
  priceRange && Array.isArray(priceRange.entries) && priceRange.entries.length > 0
    ? priceRange.entries[0]
    : null;

const currentPrice = (() => {
  if (isLoadingRange) return null;
  if (selectedEntry) return Number(selectedEntry.price);

  const raw = product?.price;
  if (raw === null || raw === undefined || raw === '') return 0;
  const parsed = Number(raw);
  return Number.isNaN(parsed) ? 0 : parsed;
})();

const rootAttributes = {
  'data-product-detail': '',
  'data-product': JSON.stringify(product ?? {}),
  'data-max-qty': String(maxQuantity),
  'data-whatsapp': String(whatsappPhone),
};
---

<div {...rootAttributes} class="fixed inset-0 z-50 flex items-end md:items-center justify-center p-0 md:p-6 overflow-hidden">
  <!-- Overlay -->
  <div data-close-overlay class="absolute inset-0 bg-black/70 backdrop-blur-md"></div>

  <!-- Modal Container -->
  <!-- Mobile: Bottom Sheet (Rounded Top) | Desktop: Centered Modal (Full Rounded) -->
  <div
    data-detail-dialog
    class={`relative w-full max-w-4xl md:max-h-[90vh] bg-white rounded-t-sm md:rounded-sm shadow-2xl overflow-hidden grid grid-cols-1 ${product?.image_url ? 'md:grid-cols-2' : 'md:grid-cols-1'} duration-300`}
  >
    <!-- Close Button (Top Right Floating - Mobile Only) -->
    <button
      data-close-overlay
      type="button"
      class="absolute top-4 right-4 p-2.5 rounded-full bg-white/90 shadow-lg hover:bg-white transition-all z-50 md:hidden"
    >
      <X class="w-6 h-6 text-secondary" />
    </button>

    {
      /* Always present (hidden when the product has no image) so a client
         script can refill this dialog for any product. */
    }
    <div
      data-detail-image-section
      hidden={!product?.image_url}
      class="w-full h-62 md:h-auto bg-neutral-200 relative overflow-hidden flex-shrink-0"
    >
      <img
        data-detail-image
        src={product?.image_url ?? ''}
        alt={product?.name ?? ''}
        class="w-full h-full object-contain"
      />
    </div>

    <!-- 2. CONTENT & ACTIONS SECTION -->
    <div class="w-full min-w-50 flex flex-col relative bg-white md:bg-transparent overflow-hidden">
      <!-- Scrollable Body (Only if content exceeds space) -->
      <div class="flex-1 overflow-y-auto p-5 pb-4">
        <!-- Close Button (Desktop Only) -->
        <button
          data-close-overlay
          type="button"
          class="hidden md:flex absolute top-6 right-6 p-2 rounded-full hover:bg-black/5 transition-colors z-20"
        >
          <X class="w-8 h-8 text-secondary" />
        </button>

        <div class="space-y-4">
          <!-- Title & Description (More compact on mobile) -->
          <div class="space-y-1 md:space-y-4">
            <h2
              data-detail-name
              class="text-3xl md:text-5xl font-display text-secondary tracking-tight leading-tight"
            >
              {product.name}
            </h2>
            <div class="w-10 md:w-20 h-1 bg-accent rounded-full"></div>
            <p
              data-detail-description
              class="text-secondary/60 font-body leading-snug text-xs md:text-lg italic line-clamp-2 md:line-clamp-none"
            >
              {product.description || 'Un clásico preparado con los secretos mejor guardados de nuestra cocina.'}
            </p>
          </div>

          <!-- Price Range Options (Compact List) -->
          {
            isLoadingRange ? (
              <div class="space-y-3 animate-pulse">
                <div class="h-4 w-24 bg-secondary/10 rounded" />
                <div class="h-14 w-full bg-secondary/5 rounded-2xl" />
                <div class="h-14 w-full bg-secondary/5 rounded-2xl" />
              </div>
            ) : (
              <div
                data-entry-list
                hidden={!priceRange}
                class="space-y-2 md:space-y-3"
                data-selected-index={selectedEntry ? '0' : ''}
              >
                <span class="text-xs font-body font-bold uppercase tracking-[0.2em] text-secondary/60">
                  Opciones disponibles
                </span>
                <div data-entry-grid class="grid grid-cols-1 gap-2">
                  {priceRange?.entries?.map((entry: any, index: number) => (
                    <button
                      data-entry-index={String(index)}
                      data-entry={JSON.stringify(entry)}
                      type="button"
                      class={`flex items-center justify-between p-2.5 rounded-xl md:rounded-2xl border-2 border-secondary/5 hover:border-accent/30 transition-all text-left group ${
                        index === 0 ? 'border-accent bg-accent/5' : ''
                      }`}
                    >
                      <div class="flex flex-col">
                        <span class="font-display text-sm md:text-lg text-secondary group-hover:text-accent transition-colors">
                          {entry.qty} Unidades
                        </span>
                        {entry.bonus && (
                          <span class="text-[9px] md:text-[10px] font-bold text-accent-muted">
                            {entry.bonus}
                          </span>
                        )}
                      </div>
                      <span class="font-display text-base md:text-xl text-secondary">
                        {precio(entry.price)}
                      </span>
                    </button>
                  ))}
                </div>
              </div>
            )
          }
        </div>
      </div>

      <!-- STICKY ACTION BAR (Footer) -->
      <div class="p-4 bg-white md:bg-white/95 backdrop-blur-md border-t border-secondary/5 shadow-[0_-10px_20px_-5px_rgba(0,0,0,0.05)] flex-shrink-0 z-30">
        <!-- Row 1: Price & Quantity -->
        <div class="flex items-start justify-between mb-4 px-1">
          <div class="flex flex-col">
            <span data-current-price class="text-3xl md:text-5xl font-display text-accent tracking-tighter leading-none">
              {
                currentPrice !== null ? (
                  precio(currentPrice)
                ) : (
                  <span class="opacity-20 animate-pulse">S/ --.--</span>
                )
              }
            </span>
            {
              <span
                data-entry-label
                hidden={!selectedEntry}
                class="text-[10px] font-bold text-secondary/40 uppercase tracking-widest mt-1"
              >
                {selectedEntry ? `${selectedEntry.qty} Unids.` : ''}
              </span>
            }
          </div>

          <!-- Quantity Selector -->
          <div
            data-quantity
            data-qty-value="1"
            class={`flex items-center gap-2 bg-secondary/5 p-1 rounded-xl border border-secondary/5 ${isLoadingRange ? 'opacity-50' : ''}`}
          >
            <button
              data-qty-dec
              type="button"
              disabled={isLoadingRange || 1 <= 1}
              class="w-8 h-8 flex items-center justify-center bg-white rounded-lg md:rounded-xl shadow-sm hover:text-accent disabled:opacity-30 transition-all"
            >
              <Minus class="w-3.5 md:w-5 h-3.5" />
            </button>
            <span data-qty-label class="w-4 md:w-6 text-center font-display text-lg md:text-2xl text-secondary">1</span>
            <button
              data-qty-inc
              type="button"
              disabled={isLoadingRange || 1 >= maxQuantity}
              class="w-8 h-8 flex items-center justify-center bg-white rounded-lg md:rounded-xl shadow-sm hover:text-accent disabled:opacity-30 transition-all"
            >
              <Plus class="w-3.5 md:w-5 h-3.5" />
            </button>
          </div>
        </div>

        <!-- Row 2: Action Buttons -->
        {
          canOrder && (
            <div class="flex gap-2">
              <button
                data-add-to-cart
                type="button"
                disabled={isLoadingRange}
                class="flex-1 bg-accent disabled:bg-secondary/20 disabled:text-secondary/40 hover:bg-accent-muted text-white py-3 rounded-sm font-display text-lg md:text-xl shadow-lg shadow-accent/20 active:scale-[0.98] transition-all flex items-center justify-center gap-2"
              >
                <ShoppingBag class="w-5 h-5 md:w-6 h-6" />
                <span>{isLoadingRange ? 'Cargando...' : 'Agregar'}</span>
              </button>

              <button
                data-whatsapp-order
                type="button"
                disabled={isLoadingRange}
                class="flex-1 bg-emerald-500 disabled:bg-secondary/20 disabled:text-secondary/40 hover:bg-emerald-700 text-white py-3 rounded-sm font-display text-lg md:text-xl active:scale-[0.98] transition-all flex items-center justify-center gap-2"
                title="Pedir por WhatsApp"
              >
                <MessageCircle class="w-6 h-6 md:w-7 h-7" />
                <span>WhatsApp</span>
              </button>
            </div>
          )
        }
      </div>
    </div>
  </div>
</div>

<script>
  import { emit } from '../../utils/events';
  import { readJson } from '../../utils/dom';
  import { precio } from '../../utils/format.js';
  import { OrderMessage, WhatsApp } from '../../utils/whatsapp.js';

  const SELECTED_CLASSES = ['border-accent', 'bg-accent/5'];

  /** Close the dialog (overlay + both close buttons). */
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    if (target?.closest('[data-close-overlay]')) {
      emit('close-product-detail', {});
    }
  });

  /** Price entry selection: move the highlight and refresh price + label. */
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const entryButton = target?.closest('[data-entry-index]');
    if (!entryButton) return;

    const root = entryButton.closest('[data-product-detail]');
    const list = entryButton.closest('[data-entry-list]');
    if (!root || !list) return;

    list.querySelectorAll('[data-entry-index]').forEach((node) => {
      node.classList.remove(...SELECTED_CLASSES);
    });
    entryButton.classList.add(...SELECTED_CLASSES);
    list.setAttribute('data-selected-index', entryButton.getAttribute('data-entry-index') ?? '');

    const entry = readJson(entryButton, 'data-entry');
    if (!entry) return;

    const price = root.querySelector('[data-current-price]');
    if (price) price.textContent = precio(Number(entry.price));

    const label = root.querySelector('[data-entry-label]');
    if (label) label.textContent = `${entry.qty} Unids.`;
  });

  /** Quantity stepper: 1 … max, mirrored into the disabled states. */
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const stepper = target?.closest('[data-quantity]');
    if (!stepper) return;

    const change = target?.closest('[data-qty-inc]') ? 1 : target?.closest('[data-qty-dec]') ? -1 : 0;
    if (change === 0) return;

    const root = stepper.closest('[data-product-detail]');
    const max = Number(root?.getAttribute('data-max-qty') || 99);

    const current = Number(stepper.getAttribute('data-qty-value') || 1);
    const next = Math.min(Math.max(current + change, 1), max);

    stepper.setAttribute('data-qty-value', String(next));
    const label = stepper.querySelector('[data-qty-label]');
    if (label) label.textContent = String(next);

    const decrease = stepper.querySelector<HTMLButtonElement>('[data-qty-dec]');
    const increase = stepper.querySelector<HTMLButtonElement>('[data-qty-inc]');
    if (decrease) decrease.disabled = next <= 1;
    if (increase) increase.disabled = next >= max;
  });

  /** Announce the add; the page owns the cart mutation, we always close after. */
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const button = target?.closest('[data-add-to-cart]');
    if (!button || (button as HTMLButtonElement).disabled) return;

    const root = button.closest('[data-product-detail]');
    if (!root) return;

    const product = readJson(root, 'data-product');
    if (!product) return;

    const stepper = root.querySelector('[data-quantity]');
    const quantity = Number(stepper?.getAttribute('data-qty-value') || 1);

    const list = root.querySelector('[data-entry-list]');
    const selectedIndex = list?.getAttribute('data-selected-index');
    const selectedButton =
      selectedIndex !== null && selectedIndex !== undefined && selectedIndex !== ''
        ? list?.querySelector(`[data-entry-index="${selectedIndex}"]`)
        : null;
    const selectedEntry = readJson(selectedButton ?? null, 'data-entry') ?? undefined;

    emit('add-to-cart', { product, quantity, selectedEntry });
    emit('close-product-detail', {});
  });

  /** Single-product WhatsApp message (same wording as the Angular dialog). */
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const button = target?.closest('[data-whatsapp-order]');
    if (!button || (button as HTMLButtonElement).disabled) return;

    const root = button.closest('[data-product-detail]');
    if (!root) return;

    const phone = root.getAttribute('data-whatsapp');
    const product = readJson(root, 'data-product');
    if (!phone || !product) return;

    const stepper = root.querySelector('[data-quantity]');
    const quantity = Number(stepper?.getAttribute('data-qty-value') || 1);

    const list = root.querySelector('[data-entry-list]');
    const selectedIndex = list?.getAttribute('data-selected-index');
    const selectedButton =
      selectedIndex !== null && selectedIndex !== undefined && selectedIndex !== ''
        ? list?.querySelector(`[data-entry-index="${selectedIndex}"]`)
        : null;
    const selectedEntry = readJson(selectedButton ?? null, 'data-entry') ?? null;

    WhatsApp.open(phone, OrderMessage.forProduct({ name: product.name, quantity, entry: selectedEntry }));
  });
</script>
