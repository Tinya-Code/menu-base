---
/**
 * TemplateCard — product row/card. Two visual variants:
 *   1. no price range  → minimalist list row
 *   2. has price range → prominent card with "Elegir cantidades"
 *
 * Props:
 * - `product`       — product payload (required)
 *
 * Listens for `add-button-click` (emitted by `ui/add-button.astro`) and
 * announces `product-click` / `add-to-cart` as bubbling CustomEvents.
 */
import Plus from '../icons/plus.astro';
import Star from '../icons/star.astro';
import AddButton from '../ui/add-button.astro';
import { precio } from '../../utils/format.js';
import { menuService } from '../../services/menu.service.js';
import { restaurantService } from '../../services/restaurant.service.js';

interface Props {
  product: any;
}

const { product } = Astro.props;

// ─── Static data: settings + price ranges ────────────────────────────────────
await restaurantService.load();
await menuService.getPriceRanges();

const canOrder = restaurantService.orderConfig?.delivery_enabled ?? true;
const hasPriceRange = !!product?.price_range_id;
const matchedRange = menuService.findPriceRange(product?.price_range_id);

/** Minimum price from the range, or the flat product price. */
const startingPrice = (() => {
  if (matchedRange && Array.isArray(matchedRange.entries) && matchedRange.entries.length > 0) {
    const prices = matchedRange.entries
      .map((entry: any) => Number(entry.price))
      .filter((n: number) => !Number.isNaN(n) && n > 0);
    return prices.length > 0 ? Math.min(...prices) : null;
  }

  const raw = product?.price;
  if (raw === '' || raw === null || raw === undefined) return null;
  const parsed = Number(raw);
  return Number.isNaN(parsed) ? null : parsed;
})();

const rootAttributes = {
  'data-template-card': '',
  'data-has-range': hasPriceRange ? 'true' : 'false',
  'data-product': JSON.stringify(product ?? {}),
};
---

{
  !hasPriceRange ? (
    /* DISEÑO 1: Producto Estándar (Estilo Lista / Minimalista) */
    <div
      {...rootAttributes}
      class="group relative py-6 px-4 md:px-6 transition-all duration-300 cursor-pointer hover:bg-secondary/5 border-b border-secondary/10 flex items-start gap-6"
    >
      <!-- Contenido Izquierdo (Info) -->
      <div class="flex-1 space-y-2">
        <div class="flex items-start gap-2">
          <h3 class="text-4xl font-display text-primary-text tracking-tight group-hover:text-accent transition-colors">
            {product.name}
          </h3>
          {product.is_recommended && <Star class="w-5 h-5 text-accent fill-accent" />}
        </div>

        <div class="flex items-center gap-4 pt-1">
          <span class="text-3xl font-display text-accent tracking-tighter">{precio(startingPrice)}</span>
          {product.qty_label && (
            <span class="text-[10px] font-bold text-secondary/40 uppercase tracking-widest">
              {product.qty_label}
            </span>
          )}
        </div>
      </div>

      <!-- Contenido Derecho (Imagen opcional y Botón) -->
      <div class="flex items-start gap-6">
        {product.image_url && (
          <div class="relative w-20 h-20 overflow-hidden rounded-xl bg-secondary/5">
            <img
              src={product.image_url}
              class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500"
              alt={product.name}
            />
          </div>
        )}

        {canOrder && <AddButton text="" class="transform group-hover:scale-110 transition-transform" />}
      </div>
    </div>
  ) : (
    /* DISEÑO 2: Producto con Rangos de Precio (Estilo Card Prominente) */
    <div
      {...rootAttributes}
      class="group relative p-4 justify-between items-center transition-all duration-300 overflow-hidden cursor-pointer bg-primary text-white rounded-b-xl rounded-t-[120px] flex flex-col h-full"
    >
      <!-- Image (Side position) -->
      <div class="relative flex rounded-full h-40 w-40 bg-secondary justify-center">
        {product.image_url && (
          <img
            src={product.image_url}
            class="w-full h-auto object-contain drop-shadow-2xl transform group-hover:-translate-x-4 transition-transform duration-700"
            alt={product.name}
          />
        )}
      </div>

      <!-- Title & Badge -->
      <div class="relative flex flex-col w-full pt-4">
        <h3 class="text-4xl flex items-start justify-between gap-2 font-display text-white tracking-tight transition-colors">
          {product.name}
          {product.is_recommended && <Star class="w-5 h-5 text-accent fill-accent" />}
        </h3>
      </div>

      <!-- Bottom: Info & Selection Action -->
      <div class="mt-auto w-full relative flex flex-col justify-between">
        <div class="flex flex-col">
          <span class="text-xs font-body font-bold uppercase tracking-[0.2em] text-white/70">Desde</span>
          <span class="text-3xl font-display text-accent tracking-tighter">{precio(startingPrice)}</span>
        </div>

        {canOrder && (
          <div class="flex justify-between w-full items-center gap-2 px-4 py-2 border-2 border-accent group-hover:bg-accent transition-colors">
            <span class="text-xs font-body font-bold uppercase tracking-widest">Elegir cantidades</span>
            <Plus class="w-4 h-4 font-bold" />
          </div>
        )}
      </div>
    </div>
  )
}
<script>
  import { cartService } from '../../services/cart.service.js';

  /** Notify the page; returns false when a listener called `preventDefault()`. */
  function emit(name: string, detail: Record<string, unknown>) {
    const event = new CustomEvent(name, { detail, bubbles: true, cancelable: true });
    return document.dispatchEvent(event);
  }

  function readProduct(element: Element | null) {
    const raw = element?.getAttribute('data-product');
    if (!raw) return null;
    try {
      return JSON.parse(raw);
    } catch {
      return null;
    }
  }

  // Card body click → open the product detail.
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const card = target?.closest('[data-template-card]');
    if (!card) return;
    // The add button owns this click (see the listener below).
    if (target?.closest('[data-add-button]')) return;

    const product = readProduct(card);
    if (product) emit('product-click', { product });
  });

  // "＋" click → add straight to the cart, or open the detail when the product
  // needs a price range selection.
  document.addEventListener('add-button-click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const card = target?.closest('[data-template-card]');
    if (!card) return;

    const product = readProduct(card);
    if (!product) return;

    if (card.getAttribute('data-has-range') === 'true') {
      emit('product-click', { product });
      return;
    }

    const detail = { product, quantity: 1, selectedEntry: undefined };
    if (emit('add-to-cart', detail)) {
      cartService.addItem(product, 1);
    }
  });
</script>
