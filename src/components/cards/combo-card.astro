---
/**
 * ComboCard — circular combo image with price badge and quick add.
 *
 * Props:
 * - `combo`       — `{ id, name, description, price, url, cloudinary_id }`
 *
 * Listens for `add-button-click` (emitted by `ui/add-button.astro`) and
 * announces `add-to-cart` as a bubbling CustomEvent.
 */
import AddButton from '../ui/add-button.astro';
import { precio } from '../../utils/format.js';
import { restaurantService } from '../../services/restaurant.service.js';

interface Props {
  combo: any;
}

const { combo } = Astro.props;

await restaurantService.load();
const canOrder = restaurantService.orderConfig?.delivery_enabled ?? true;
---

<div
  data-combo-card
  data-combo={JSON.stringify(combo ?? {})}
  class="group relative p-6 transition-all duration-300 overflow-hidden cursor-pointer active:scale-100 rounded-sm border-2 border-transparent hover:border-2 hover:border-accent flex flex-col"
>
  <!-- Combo Badge -->
  <div class="relative flex flex-col h-full gap-4">
    <div class="relative w-50 h-50 mx-auto rounded-full border border-white group">
      <!-- Imagen circular -->
      <img
        src={combo.url}
        alt={combo.name}
        title={combo.name}
        class="w-full h-auto transition-transform duration-300"
      />
      <p class="absolute -bottom-4 -left-4 translate-x-1/2 py-1 px-4 rounded-sm tracking-widest bg-primary font-display text-white text-xl">
        {precio(combo.price)}
      </p>
      {
        canOrder && (
          <AddButton customClass="absolute bottom-0 -right-5 border-px border-white active" />
        )
      }
    </div>

    <div class="flex-1 flex flex-col gap-3">
      <h3 class="text-3xl font-display text-primary-text text-center">{combo.name}</h3>

      <div class="flex gap-3 mt-auto">
        <p class="text-primary-text/70 max-w-xs text-center font-body leading-relaxed line-clamp-3">
          {combo.description}
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  import { cartService } from '../../services/cart.service.js';

  /** Notify the page; returns false when a listener called `preventDefault()`. */
  function emit(name: string, detail: Record<string, unknown>) {
    const event = new CustomEvent(name, { detail, bubbles: true, cancelable: true });
    return document.dispatchEvent(event);
  }

  function readCombo(element: Element | null) {
    const raw = element?.getAttribute('data-combo');
    if (!raw) return null;
    try {
      return JSON.parse(raw);
    } catch {
      return null;
    }
  }

  document.addEventListener('add-button-click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const card = target?.closest('[data-combo-card]');
    if (!card) return;

    const combo = readCombo(card);
    if (!combo) return;

    if (emit('add-to-cart', { product: combo, quantity: 1, selectedEntry: undefined })) {
      cartService.addItem(combo, 1);
    }
  });
</script>
