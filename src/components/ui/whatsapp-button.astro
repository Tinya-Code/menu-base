---
/**
 * WhatsAppButton — floating WhatsApp bubble with an auto-hiding tooltip.
 *
 * Port of Angular `src/app/components/whatsapp-button/*`.
 *
 * Props (the page resolves them from `whatsapp_config`, F5):
 * - `phone`   — number the link opens
 * - `message` — prefilled message
 *
 * The URL is built in frontmatter, exactly like the Angular `computed()`s;
 * only the tooltip timing needs client code.
 */
import { WhatsApp } from '../../utils/whatsapp.js';
import Whatsapp from '../icons/whatsapp.astro';

interface Props {
  phone?: string;
  message?: string | null;
}

const { phone = '', message = null } = Astro.props;

const whatsappUrl = WhatsApp.link(phone, message ?? 'Hola, me gustaría información');
---

<div
  class="fixed bottom-24 right-6 z-10 flex flex-col items-end gap-2 pb-[env(safe-area-inset-bottom)]"
>
  <!-- Tooltip -->
  <div
    data-whatsapp-tooltip
    class="bg-slate-900 text-white px-3 py-1.5 rounded-lg shadow-lg text-[10px] font-medium tracking-wide uppercase transition-all duration-300 origin-right opacity-0 translate-x-4 pointer-events-none"
  >
    Escríbenos
  </div>

  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    data-whatsapp-link
    class="w-12 h-12 bg-[#25D366] text-white rounded-full shadow-md hover:shadow-lg flex items-center justify-center transition-all duration-200 relative group"
    aria-label="Hablar por WhatsApp"
  >
    <Whatsapp class="w-6 h-6 fill-current" />
  </a>
</div>

<script>
  const tooltip = document.querySelector<HTMLElement>('[data-whatsapp-tooltip]');
  const link = document.querySelector<HTMLElement>('[data-whatsapp-link]');
  if (tooltip) {
    const show = () => tooltip.classList.remove('opacity-0', 'translate-x-4', 'pointer-events-none');
    const hide = () => tooltip.classList.add('opacity-0', 'translate-x-4', 'pointer-events-none');

    // Angular: appears after 3 s, disappears 8 s later; hovering overrides it.
    window.setTimeout(() => {
      show();
      window.setTimeout(hide, 8000);
    }, 3000);

    link?.addEventListener('mouseenter', show);
    link?.addEventListener('mouseleave', hide);
  }
</script>
