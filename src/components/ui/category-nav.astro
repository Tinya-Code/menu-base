---
/**
 * CategoryNav — sticky horizontal pill bar that scrolls to each category.
 *
 * Port of Angular `src/app/components/category-nav/category-nav.component.ts`.
 *
 * Props:
 * - `categories` — `Array<{ category }>` (the `allCategories` shape used by
 *                  `Menu`): the component only reads `category.id` and
 *                  `category.name`.
 *
 * The anchors keep their `#category-{id}` href so the nav still works without
 * JavaScript; the script only adds the 140 px scroll offset from Angular.
 */
interface Props {
  categories?: any[];
}

const { categories = [] } = Astro.props;
---

<div
  class="sticky top-0 z-40 bg-background/90 backdrop-blur-md border-b border-primary/10 shadow-sm py-4 px-4"
>
  <div
    class="max-w-7xl mx-auto flex items-center gap-3 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
  >
    {
      categories.map(({ category }) => (
        <a
          href={`#category-${category.id}`}
          data-category-link
          class="whitespace-nowrap px-6 py-2.5 rounded-full text-sm font-bold uppercase tracking-wider transition-all bg-secondary/5 text-secondary hover:bg-primary/20 hover:text-primary active:scale-95 cursor-pointer"
        >
          {category.name}
        </a>
      ))
    }
  </div>
</div>

<script>
  /** Angular `scrollToCategory()` — smooth scroll with a fixed header offset. */
  const HEADER_OFFSET = 140;

  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const link = target?.closest<HTMLAnchorElement>('[data-category-link]');
    if (!link) return;

    const id = link.getAttribute('href')?.slice(1);
    if (!id) return;

    const element = document.getElementById(id);
    if (!element) return;

    event.preventDefault();

    const elementPosition = element.getBoundingClientRect().top + window.scrollY;
    window.scrollTo({
      top: elementPosition - HEADER_OFFSET,
      behavior: 'smooth',
    });
  });
</script>
