---
/**
 * MenuBlock — generic skeleton for one menu section.
 *
 * Zero block-specific knowledge: grid classes, section attributes and
 * decoration markup all arrive from the caller (props + NAMED SLOTS). The
 * component owns only the shared skeleton (category sections + cards) and
 * the client-side animation bootstrap.
 *
 * Props:
 * - `categories`      — categories rendered as sections; when empty the
 *                       block renders NOTHING (rendering guard).
 * - `sectionAttrs`    — extra section attributes (e.g. `data-block-1`,
 *                       `data-maki-urls` for the client-side maki rail).
 * - `outerClass` / `cardsClass` / `categorySectionClass` — per-block grids
 * - `canOrder` / `priceRanges` — card data the page resolves once (F5)
 *
 * Named slots:
 * - `decoration-left`  — grid cell(s) BEFORE the categories
 * - `decoration-right` — grid cell(s) AFTER the categories
 * - `extra`            — extra grid cell(s) after the decorations
 * - default            — content at the end of the section
 */
import TemplateCard from '../cards/template-card.astro';
import TemplateSectionTitle from '../ui/template-section-title.astro';
import type { MenuCategory, PriceRange } from '../../types/menu';

interface Props {
  categories?: MenuCategory[];
  sectionAttrs?: Record<string, string>;
  outerClass?: string;
  cardsClass?: string;
  categorySectionClass?: string;
  canOrder?: boolean;
  priceRanges?: PriceRange[];
}

const {
  categories = [],
  sectionAttrs = {},
  outerClass = '',
  cardsClass = '',
  categorySectionClass = '',
  canOrder = true,
  priceRanges = [],
} = Astro.props;

/**
 * Section classes: blocks with decorations carry `overflow-hidden`, the
 * plain ones do not.
 */
const hasDecorations =
  Astro.slots.has('decoration-left') || Astro.slots.has('decoration-right');
---

{
  categories.length > 0 && (
    <section
      {...sectionAttrs}
      class={`relative py-12 px-8${hasDecorations ? ' overflow-hidden' : ''}`}
    >
      <div class={`grid ${outerClass}`}>
        <slot name="decoration-left" />

        {categories.map((cat) => (
          <section
            id={`category-${cat.id}`}
            class={`flex flex-col scroll-mt-[140px] ${categorySectionClass}`.trim()}
          >
            <TemplateSectionTitle title={cat.name ?? ''} description={cat.description || ''} />

            <div class={`grid ${cardsClass}`}>
              {(cat.products ?? []).map((product) => (
                <TemplateCard product={product} priceRanges={priceRanges} canOrder={canOrder} />
              ))}
            </div>
          </section>
        ))}

        <slot name="decoration-right" />

        <slot name="extra" />
      </div>

      <slot />
    </section>
  )
}

<script>
  import { initAnimations } from '../../scripts/animations';

  const initAll = () => initAnimations(document);

  initAll();
  // Covers Astro's client-side navigation as well as the initial render.
  document.addEventListener('astro:page-load', initAll);
</script>
