{
  "background": "/images/bg.png",
  "header_background": null,
  "footer_background": null,
  "blocks": {
    "block-1": [
      {
        "slot": "left",
        "type": "rail",
        "containerClass": "relative hidden md:block col-span-0 md:col-span-2 h-full",
        "items": [
          "/images/fila-maki1.png",
          "/images/fila-maki2.png",
          "/images/fila-maki3.png"
        ]
      },
      {
        "slot": "right",
        "type": "image",
        "src": "/images/fila-barco.png",
        "alt": "Barco Decoración",
        "containerClass": "relative md:block col-span-1 md:col-span-2 h-full",
        "class": "absolute top-0 -right-28 md:-right-48 min-w-[300px] md:min-w-[400px] object-contain will-change-transform transition-transform duration-75 ease-out",
        "animation": "parallax",
        "attrs": {
          "data-barco": ""
        }
      }
    ],
    "block-3": [
      {
        "slot": "left",
        "type": "group",
        "containerClass": "justify-between flex col-span-12 h-60 md:col-span-12 md:h-0",
