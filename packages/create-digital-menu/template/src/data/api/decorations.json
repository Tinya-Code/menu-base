          {
            "src": "/images/alitas-fondo.png",
            "alt": "Alitas Fondo",
            "class": "h-full md:h-auto md:w-130 md:absolute top-10 -right-35"
          },
          {
            "src": "/images/alitas-2-fondo.png",
            "alt": "Alitas 2 Fondo",
            "class": "h-full md:h-auto md:w-130 md:absolute bottom-10 -right-35"
          }
        ]
      }
    ],
    "block-6": [
      {
        "slot": "left",
        "type": "image",
        "src": "/images/cocteles-vertical.png",
        "alt": "Cócteles Vertical",
        "containerClass": "w-full relative h-full col-span-1 flex justify-center items-center md:col-span-4",
        "class": "absolute md:static -left-70 min-w-[500px] md:min-w-[450px] h-auto"
      }
    ]
  },
  "block1": {
    "barco": "/images/fila-barco.png",
    "makis": [
      "/images/fila-maki1.png",
      "/images/fila-maki2.png",
      "/images/fila-maki3.png"
    ]
  },
  "block3": {
    "alitasFondo": "/images/alitas-fondo.png",
    "alitas2Fondo": "/images/alitas-2-fondo.png"
